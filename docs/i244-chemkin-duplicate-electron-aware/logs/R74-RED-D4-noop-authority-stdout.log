        lonely = _library_reaction(
            [h2], [h, h], "NeutralLibC", duplicate=True,
            kinetics=Arrhenius(A=(3.0e12, "s^-1"), n=0.0, Ea=(0.0, "kcal/mol")),
        )
        before = [first.duplicate, second.duplicate, lonely.duplicate]

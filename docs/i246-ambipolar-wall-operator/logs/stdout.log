        rb, _, _ = _build_reactor(wall=True, with_chemistry=True, x_ion=1.0e-7,
                                  quasineutral=True)
        ra.charge_row_scale = 1.0
        rb.charge_row_scale = 1.0e6
        assert ra.charge_row_scale != rb.charge_row_scale
    
